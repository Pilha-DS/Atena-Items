<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/agenda_sync_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/agenda_sync_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/agenda_sync_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/agenda_sync"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/agenda_sync_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/agenda_sync_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/activity_margin"
            android:paddingTop="@dimen/activity_margin"
            android:paddingEnd="@dimen/activity_margin"
            android:paddingBottom="@dimen/activity_margin">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/agenda_sync_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_margin"
                android:text="@string/agenda_sync_description"
                android:textSize="@dimen/normal_text_size" />

            <org.fossify.commons.views.MyTextInputLayout
                android:id="@+id/agenda_sync_url_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_margin"
                android:hint="@string/agenda_sync_url_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/agenda_sync_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/bigger_text_size" />

            </org.fossify.commons.views.MyTextInputLayout>

            <org.fossify.commons.views.MyTextInputLayout
                android:id="@+id/agenda_sync_token_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_margin"
                android:hint="@string/agenda_sync_token_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/agenda_sync_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/bigger_text_size" />

            </org.fossify.commons.views.MyTextInputLayout>

            <org.fossify.commons.views.MyTextInputLayout
                android:id="@+id/agenda_sync_device_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_margin"
                android:hint="@string/agenda_sync_device_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/agenda_sync_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="80"
                    android:singleLine="true"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/bigger_text_size" />

            </org.fossify.commons.views.MyTextInputLayout>

            <org.fossify.commons.views.MyButton
                android:id="@+id/agenda_sync_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/medium_margin"
                android:text="@string/agenda_sync_save"
                android:textAllCaps="false" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/agenda_sync_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_margin"
                android:textSize="@dimen/normal_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/agenda_sync_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/small_margin"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/agenda_sync_disconnect"
                android:textAllCaps="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
