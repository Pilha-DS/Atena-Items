<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quick_timer_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/medium_margin">

    <ImageView
        android:id="@+id/quick_timer_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:padding="@dimen/medium_margin"
        android:src="@drawable/ic_delete_vector" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/quick_timer_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/quick_timer_delete"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        tools:text="Ir ao mercado" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/quick_timer_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/quick_timer_title"
        android:layout_toStartOf="@+id/quick_timer_delete"
        android:fontFamily="monospace"
        android:textSize="@dimen/bigger_text_size"
        tools:text="19:42" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/quick_timer_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/quick_timer_remaining"
        android:layout_toStartOf="@+id/quick_timer_delete"
        android:textSize="@dimen/smaller_text_size"
        tools:text="Ends at 15:42" />

</RelativeLayout>
