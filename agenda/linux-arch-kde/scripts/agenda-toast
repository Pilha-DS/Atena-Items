#!/usr/bin/env bash
#
# Raises a toast in the running Agenda: the app's own card in the top-right
# corner of the screen, the same one the day notifications and the end of a
# quick timer use.
#
#   agenda-toast "Título"                    one line
#   agenda-toast "Título" "Corpo"            title + body (body may be multiline)
#   agenda-toast --urgent "Título" "Corpo"   accent color, for what is ringing
#   agenda-toast --help
#
# Any process of the suite can call it, and it is what the notify-send shim
# installed by ./scripts/install.sh forwards to. The request is a file in the
# app's IPC directory, so this returns at once: the caller never waits for the
# toast to be drawn.
#
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/agenda"
APP_BIN="${AGENDA_BIN:-$HOME/.local/opt/agenda/bin/agenda}"

usage() {
    cat <<'EOF'
uso: agenda-toast [--urgent] "título" ["corpo"]

  --urgent, -u   toast urgente (cor de destaque), para o que está tocando
  --help, -h     esta ajuda

O app precisa estar instalado; se estiver fechado, ele sobe escondido para
mostrar o toast.
EOF
}

urgent=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -u | --urgent)
            urgent=1
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "agenda-toast: opção desconhecida: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

title="${1:-}"
body="${2:-}"
if [[ -z "$title" ]]; then
    usage >&2
    exit 2
fi

# The app publishes the directory it actually uses; fall back to the same
# rules it applies when there is no running instance yet.
ipc_dir() {
    local published=""
    if [[ -f "$CONFIG_DIR/ipc-dir" ]]; then
        published="$(head -n 1 "$CONFIG_DIR/ipc-dir" 2>/dev/null || true)"
    fi
    if [[ -n "$published" && -d "$published" ]]; then
        printf '%s\n' "$published"
        return
    fi
    if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" && -w "$XDG_RUNTIME_DIR" ]]; then
        printf '%s\n' "$XDG_RUNTIME_DIR/agenda"
        return
    fi
    printf '%s\n' "${XDG_CACHE_HOME:-$HOME/.cache}/agenda/run"
}

# The app is a single instance and the helper already knows how to start it
# hidden; `prewarm` exits at once when it is already running.
ensure_app() {
    if [[ ! -x "$APP_BIN" ]]; then
        APP_BIN="$(command -v agenda || true)"
    fi
    [[ -n "$APP_BIN" && -x "$APP_BIN" ]] || return 1

    if command -v agenda-toggle >/dev/null 2>&1; then
        agenda-toggle prewarm >/dev/null 2>&1 || true
        return 0
    fi
    setsid nohup "$APP_BIN" --hidden >>"$DIR/agenda.log" 2>&1 &
}

DIR="$(ipc_dir)"
mkdir -p "$DIR/toasts"

if ! ensure_app; then
    echo "agenda-toast: Agenda não está instalado (esperado em $APP_BIN)" >&2
    exit 1
fi

# Written under a temporary name and renamed into place: the app drains the
# spool continuously, and it must never read a half-written request. The name
# carries the urgency and the timestamp, which is also the order they appear.
prefix="n"
[[ "$urgent" -eq 1 ]] && prefix="u"
temp="$DIR/toasts/.$prefix-$$.tmp"
final="$DIR/toasts/$prefix-$(date +%s%N)-$$.req"
printf '%s\n%s\n' "$title" "$body" >"$temp"
mv -f "$temp" "$final"
