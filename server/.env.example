# Optional: copy to .env and edit. docker compose reads it automatically.
# A fixed token is useful so you do not have to look it up in the logs again.
JOTTER_SERVER_TOKEN=

# Host port published on the machine (container always listens on 8080).
# Change it when 8080 is already taken, e.g. JOTTER_HOST_PORT=8090
JOTTER_HOST_PORT=8080

# Shown on the start page as a connection hint, e.g. https://notas.exemplo.com
JOTTER_PUBLIC_URL=
